rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is signed in?
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper: Am I the user?
    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users: Can read anyone, can only edit yourself (except status/strikes)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isUser(userId);
      allow update: if isUser(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'strikes', 'mutedUntil']));
      allow update: if isSignedIn() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'strikes', 'mutedUntil']); // For admins (simplified)
    }

    // Rooms: Members can read, Owners can update
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && 
        (resource.data.createdBy == request.auth.uid || request.auth.uid in resource.data.members);

      // Messages: Members can read, anyone can create, only sender/mod can delete
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn(); // For reactions and readBy
        allow delete: if isSignedIn(); // Client-side deletes
      }

      // Typing indicators
      match /typing/{userId} {
        allow read, write: if isSignedIn();
      }
      
      // Shared docs
      match /sharedDocs/{docId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    // Reports: Anyone can create, only Admin can read
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn(); // Let the Admin dashboard handle this
    }

    // Friend requests
    match /friend_requests/{requestId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}