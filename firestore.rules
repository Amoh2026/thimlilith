rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == "admin";
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isApproved() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).approved == true;
    }

    // ============================================================
    // USERS — single source of truth for members
    // ============================================================
    match /users/{uid} {

      // Read: own doc, or admin reads anyone
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // Create: only self, must start as unapproved MEMBER
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == "MEMBER"
        && request.resource.data.approved == false
        && request.resource.data.email == request.auth.token.email;

      // Update:
      //   - user can only change "name"
      //   - admin can change anything (approve/reject)
      allow update: if isSignedIn()
        && (
          (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
          ||
          isAdmin()
        );

      // Delete: admins only
      allow delete: if isAdmin();
    }

    // ============================================================
    // MEMBER-ONLY CONTENT (examples — apply to your own collections)
    // ============================================================
    match /member_content/{docId} {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin();
    }

    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /posts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /messages/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

        match /bookings/{docId} {
      // Owner can read their own booking
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Admins can read any booking (needed for list queries)
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ============================================================
    // LEGACY / CONTACT REGISTRY — read-only from client, admin-only writes
    // (keeps your old "members" collection safe but locked down)
    // ============================================================
    match /members/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // DEFAULT — deny anything not explicitly allowed
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}